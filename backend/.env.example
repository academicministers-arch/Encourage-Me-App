# Secret key for JWT signing - change this in production
SECRET_KEY=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# YouTube Data API v3 key (get one free at https://console.cloud.google.com/apis/credentials)
# The app works without it (falls back to curated static content) but music/video
# recommendations will be richer and dynamic if you add a key.
YOUTUBE_API_KEY=

# Hugging Face API token (get one free at https://huggingface.co/settings/tokens)
# Enables real emotion classification (tone/phrasing, not just keyword matching)
# using the SamLowe/roberta-base-go_emotions model. Optional — without it, the
# app falls back to local keyword-based emotion detection automatically.
HUGGINGFACE_API_TOKEN=

# Pexels API key (get one free at https://www.pexels.com/api/)
# Enables theme background search for the Emotion Calendar on the Emotional Journey page.
PEXELS_API_KEY=

# Quotes: powered by ZenQuotes.io (https://zenquotes.io) — free, no API key
# required. Falls back to a local curated quote list automatically if it's
# ever unreachable. Nothing to configure here.

# --- Google Sign-In ---
# (GOOGLE_CLIENT_ID=415191840521-r6a9v45p76qte1hnbm4ma0cvft228n9j.apps.googleusercontent.comalready documented below if present)

# --- Flutterwave (paid consultation access — MTN & Airtel Mobile Money) ---
# Get keys at https://dashboard.flutterwave.com/settings/apis
# Use TEST keys while developing (no real money moves). Only switch to
# LIVE keys once Flutterwave has completed your business verification.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Set this to a secret string of your choosing, and enter the SAME string
# in your Flutterwave dashboard's webhook settings — used to confirm a
# webhook call genuinely came from Flutterwave.
FLUTTERWAVE_WEBHOOK_HASH=

# --- Admin access ---
# Comma-separated email addresses that should automatically become admins
# (able to manage consultants) the moment they register or log in.
# Set this to your own email BEFORE creating your account.
ADMIN_EMAILS=admin@example.com

LISTEN_NOTES_API_KEY=

# Dailymotion API key (optional for public catalog searches)
DAILYMOTION_API_KEY=
DAILYMOTION_API_SECRET=
# Origin allowed to call this API in the browser (Vite dev server default)
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
AUTO_CREATE_SCHEMA=false
